# Local-first: the default inference provider is LM Studio at
# http://127.0.0.1:1234/v1 (OpenAI-compatible). Load a chat model in LM Studio
# yourself; ZCode does not start or load models. No Z.ai / BigModel login, API
# key, Coding Plan, or trial quota is required to send a prompt.
#
# Optional LM Studio Bearer token. Unset/blank uses "lm-studio", which works
# with unprotected LM Studio instances.
# LM_STUDIO_API_KEY=
#
# Optional: pin one LM Studio model id to the front of the picker catalog.
# Must match a listed id exactly; a typo keeps catalog order instead of failing.
# LM_STUDIO_MODEL=
#
# The Z.ai / BigModel addresses below are only for optional cloud accounts or
# private deployments; leave them unset for local use.
# ZCODE_BASE_URL=https://zcode.z.ai
# BIGMODEL_API_BASE_URL=https://bigmodel.cn
# ZAI_OAUTH_ORIGIN=https://chat.z.ai
# ZAI_BUSINESS_BASE_URL=https://api.z.ai
# ZAI_OAUTH_CLIENT_ID=client_P8X5CMWmlaRO9gyO-KSqtg
# ZCODE_CDN_BASE_URL=https://cdn-zcode.z.ai

# Backlink base for imported sessions; does not change the API. Keep /cn/share, no share code.
# Update this value when the API origin changes, or delete it to follow the API origin; never set it empty.
ZCODE_CONVERSATION_SHARE_WEB_URL=https://zcode.z.ai/cn/share
# Full remote-resource override URL; must contain the running version. Delete to auto-derive from the version.
ZCODE_REMOTE_ASSET_CDN_BASE_URL=https://cdn-zcode.z.ai/zcode/electron/releases/3.14.0

# Optional local provider config file path; leave empty to use the built-in online config.
ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# Intranet or private-deployment addresses have no online default; fill in explicitly as needed.
ZCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=

# CLI package download base URL: leave empty to use this fork's latest GitHub
# Release; release builds pin --base-url to that tag URL for reproducibility.
ZCODE_DIST_BASE_URL=
